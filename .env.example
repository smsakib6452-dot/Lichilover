# =====================================================================
# Lichi Lover — Environment configuration
# Copy this file to `.env` (or `config/local.php`) and fill in values.
# NEVER commit the real .env or local.php to GitHub.
# =====================================================================

# Application
APP_ENV=development
APP_NAME=Lichi Lover
APP_TAGLINE=Freshness You Can Taste.
APP_TIMEZONE=Asia/Dhaka

# Base URL override. Leave empty to auto-detect (recommended).
# Example: BASE_URL=/lichi-lover/
BASE_URL=

# Database
DB_HOST=127.0.0.1
DB_NAME=lichi_lover
DB_USER=root
DB_PASS=

# Currency
CURRENCY=৳

# Payments — MANDATORY for real transactions.
# demo   = simulated flow, NO real money charged (default)
# live   = real gateway integration (you must provide credentials)
PAYMENT_MODE=demo

# bKash (Tokenized Checkout)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# Nagad
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_BASE_URL=https://sandbox.mynagad.com

# Business / contact placeholders (replace with real values)
SHOP_EMAIL=hello@lichilover.example
SHOP_PHONE=
SHOP_ADDRESS=

# WhatsApp number in international format without +, e.g. 8801712345678
# Leave empty to hide the WhatsApp button.
WHATSAPP_NUMBER=
